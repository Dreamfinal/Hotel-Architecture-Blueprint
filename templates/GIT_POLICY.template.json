{
  "schema_version": 1,
  "hotel_id": "replace-me",
  "repository_root": "absolute-or-repository-relative-description",
  "remote": "origin",
  "target_branch": "main",
  "baseline_ref": "origin/main",
  "baseline_sha": "UNPINNED",
  "branch_pattern": "hotel/replace-me/room-{room_id}",
  "worktree_pattern": "../worktrees/replace-me-{room_id}",
  "claim_mechanism": "remote_branch_plus_verified_claim",
  "force_push_allowed": false,
  "integration_strategy": "merge_commit",
  "integration_owner": "replace-me",
  "required_checks": [],
  "post_merge_checks": [],
  "rollback_strategy": "revert_merge_commit",
  "permissions": {
    "create_branch": "ask_or_explicit_scope",
    "commit": "ask_or_explicit_scope",
    "push": "explicit_only",
    "open_pr": "explicit_only",
    "merge": "explicit_only",
    "deploy": "explicit_only",
    "delete_branch_or_worktree": "explicit_only"
  }
}
