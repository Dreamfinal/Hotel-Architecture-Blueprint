{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamfinal.github.io/hotel-protocol/vnext/ROOM_MANIFEST.schema.json",
  "title": "Hotel Protocol vNext - Room Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hotel_id",
    "room_id",
    "title",
    "objective",
    "logical_state",
    "depends_on",
    "claim_base_sha",
    "inputs",
    "source_read_allowlist",
    "skills",
    "tools",
    "authority",
    "write_allowlist",
    "return_allowlist",
    "checks",
    "acceptance_criteria",
    "return_contract",
    "reviewer",
    "escalation_conditions"
  ],
  "properties": {
    "schema_version": {"const": "room-vnext-0.1"},
    "hotel_id": {"type": "string", "minLength": 1},
    "room_id": {"type": "string", "pattern": "^R[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "logical_state": {
      "enum": ["DRAFT", "BLOCKED", "READY", "CLAIMED", "IN_PROGRESS", "RETURNED", "REVIEW", "ACCEPTED", "REWORK"]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^R[0-9]{3,}$"}
    },
    "claim_base_sha": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        {"type": "null"}
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_read_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "purpose": {"type": "string"}
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "required"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "write_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "return_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "required", "expected_exit_code"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "expected_exit_code": {"type": "integer"},
          "requires_capability": {"type": ["string", "null"]}
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_path", "required_fields"],
      "properties": {
        "report_path": {"type": "string", "minLength": 1},
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewer": {"type": "string", "minLength": 1},
    "next_to": {"type": ["string", "null"]},
    "escalation_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "logical_state": {
            "enum": ["READY", "CLAIMED", "IN_PROGRESS", "RETURNED", "REVIEW", "ACCEPTED", "REWORK"]
          }
        },
        "required": ["logical_state"]
      },
      "then": {
        "properties": {
          "claim_base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
        }
      }
    }
  ]
}